<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_crm_event" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.crm.event</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="event_sale.sale_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="event_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='event_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
