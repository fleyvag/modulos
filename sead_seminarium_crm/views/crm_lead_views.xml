<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Pestaña "Lineas de pedido" en la oportunidad -->
        <record id="view_form_crm_lead_inherited" model="ir.ui.view">
            <field name="name">view.from.crm.lead.inherited</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- En v17 el formulario de oportunidad es crm.crm_lead_view_form
                     (crm.crm_case_form_view_oppor ya no existe) y la pestaña
                     de notas tiene name="internal_notes". -->
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page string="Lineas de pedido">
                        <field name="crm_line" nolabel="1" context="{'type': type}">
                            <tree string="Lineas de pedido" editable="bottom">
                                <field name="product_id"
                                       domain="[('name', 'in', ['CUPO/DIA COMPLETO', 'CUPO/DIA 2', 'CUPO/DIA 1'])]"
                                       required="1"/>
                                <field name="description"/>
                                <field name="qty" required="1"/>
                                <field name="price_unit" required="1"/>
                                <field name="analytics_id" required="1"/>
                                <field name="tax_id" widget="many2many_tags"/>
                                <field name="sub_total"/>
                                <field name="name_analytics" column_invisible="1"/>
                                <field name="name_product" column_invisible="1"/>
                                <field name="product_uom" column_invisible="1"/>
                            </tree>
                        </field>
                        <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                            <field name="currency_active" invisible="1"/>
                            <field name="planned_revenue_usd" invisible="1"/>
                            <field name="amount_of_quota" invisible="1"/>
                            <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_active'}"/>
                            <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_active'}"/>
                            <div class="oe_subtotal_footer_separator oe_inline">
                                <label for="amount_total"/>
                            </div>
                            <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_active'}"/>
                        </group>
                        <div class="oe_clear"/>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Botón "Convertir a cotización" -->
        <record id="crm_case_form_view_oppor_inherit_seminarium" model="ir.ui.view">
            <!-- El original declaraba este <record> con id="sale_crm.crm_case_form_view_oppor_inherit",
                 es decir, con el prefijo de OTRO módulo (sale_crm) en su
                 propio id. Eso es inválido/riesgoso: un módulo no debe
                 declarar registros bajo el namespace de otro módulo salvo
                 que lo esté extendiendo explícitamente vía herencia XML
                 (que es justamente lo que ya hace el campo inherit_id de
                 abajo). Se corrigió a un id propio de este módulo. -->
            <field name="name">crm.lead.oppor.inherited</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <!-- Sustituye el botón "Nueva cotización" de sale_crm. -->
                <xpath expr="//button[@name='action_sale_quotations_new']" position="replace">
                    <button string="Convertir a cotización" name="action_create_quotation" type="object" class="oe_highlight" data-hotkey="q"
                            invisible="type == 'lead' or probability == 0 and not active"/>
                </xpath>
            </field>
        </record>

        <!-- Campo "Peso del cupo" en la ficha de producto -->
        <record id="view_form_product_product_peso_inherited" model="ir.ui.view">
            <!-- El original declaraba model="product.product" pero heredaba
                 la vista product.product_template_only_form_view, que
                 pertenece al modelo product.template (no product.product).
                 Eso genera un error de Odoo ("modelos distintos entre vista
                 base y heredada"). El campo peso_cupo además vive en
                 product.template. Se corrigió el model a product.template. -->
            <field name="name">crm.lead.product.peso</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <field name="default_code" position="after">
                    <field name="peso_cupo"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
